DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stockintel?schema=public"
PORT=4000
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
CORS_ORIGIN=http://localhost:5173
MARKET_DATA_PROVIDER=demo
# LIVE market mode: demo = local DB seed data, live = real NSE/BSE provider data (never mixed)
MARKET_MODE=demo
# Market data provider: "yahoo" (default, keyless) or "fyers" (requires credentials)
# MARKET_DATA_PROVIDER=yahoo
# WebSocket server port for real-time streaming (FYERS only)
WS_PORT=4001
# FYERS API credentials (required when MARKET_DATA_PROVIDER=fyers)
# Register at https://myapi.fyers.in to get these.
# FYERS_APP_ID=
# FYERS_SECRET_KEY=
# FYERS_REDIRECT_URL=http://localhost:4000/api/v1/market/fyers/callback
# FYERS_ACCESS_TOKEN=

