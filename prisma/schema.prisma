generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Exchange {
  id     String  @id @default(cuid())
  code   String  @unique // e.g. NSE, BSE
  name   String
  stocks Stock[]
}

model Company {
  id          String  @id @default(cuid())
  name        String
  description String?
  sector      String?
  industry    String?
  website     String?
  stocks      Stock[]
}

model Stock {
  id              String               @id @default(cuid())
  symbol          String               @unique
  companyId       String
  company         Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  exchangeId      String
  exchange        Exchange             @relation(fields: [exchangeId], references: [id])
  quotes          Quote[]
  historical      HistoricalPrice[]
  fundamental     Fundamental?
  statements      FinancialStatement[]
  news            News[]
  score           StockScore?
  aiAnalyses      AiAnalysis[]
  createdAt       DateTime             @default(now())
}

model Quote {
  id         String   @id @default(cuid())
  stockId    String
  stock      Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  price      Float
  change     Float
  changePct  Float
  volume     BigInt
  marketCap  Float?
  dayHigh    Float?
  dayLow     Float?
  week52High Float?
  week52Low  Float?
  updatedAt  DateTime @updatedAt

  @@index([stockId])
}

model HistoricalPrice {
  id      String   @id @default(cuid())
  stockId String
  stock   Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  date    DateTime
  open    Float
  high    Float
  low     Float
  close   Float
  volume  BigInt

  @@unique([stockId, date])
  @@index([stockId, date])
}

model Fundamental {
  id            String   @id @default(cuid())
  stockId       String   @unique
  stock         Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  pe            Float?
  pb            Float?
  eps           Float?
  roe           Float?
  roce          Float?
  debtEquity    Float?
  dividendYield Float?
  revenue       Float?
  profit        Float?
  revenueGrowth Float?
  profitGrowth  Float?
  rsi           Float?
  sma50         Float?
  sma200        Float?
  updatedAt     DateTime @updatedAt
}

model FinancialStatement {
  id      String @id @default(cuid())
  stockId String
  stock   Stock  @relation(fields: [stockId], references: [id], onDelete: Cascade)
  year    Int
  revenue Float?
  profit  Float?
  eps     Float?
  assets  Float?
  debt    Float?
  equity  Float?

  @@unique([stockId, year])
}

model News {
  id          String   @id @default(cuid())
  stockId     String?
  stock       Stock?   @relation(fields: [stockId], references: [id], onDelete: Cascade)
  title       String
  summary     String?
  url         String?
  source      String?
  publishedAt DateTime @default(now())

  @@index([stockId])
}

model StockScore {
  id            String   @id @default(cuid())
  stockId       String   @unique
  stock         Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  total         Float
  valuation     Float
  growth        Float
  profitability Float
  strength      Float
  technical     Float
  explanation   String?
  updatedAt     DateTime @updatedAt
}

model AiAnalysis {
  id               String   @id @default(cuid())
  stockId          String
  stock            Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  summary          String
  fundamental      String?
  newsSummary      String?
  risks            String?
  strengths        String?
  scoreExplanation String?
  createdAt        DateTime @default(now())

  @@index([stockId, createdAt])
}

model ApiSyncLog {
  id        String   @id @default(cuid())
  provider  String
  resource  String
  status    String
  message   String?
  createdAt DateTime @default(now())
}

// Stored AI forecasts (real predictions only) for later accuracy tracking
// against real market prices. Never edited, only appended.
model ForecastRecord {
  id          String   @id @default(cuid())
  symbol      String
  exchange    String   @default("NSE")
  asOf        DateTime
  priceAtTime Float
  central     Float
  low         Float
  high        Float
  expectedPct Float
  score       Int
  signal      String
  trend       String
  confidence  Int?
  dataTime    DateTime?
  createdAt   DateTime @default(now())

  @@index([symbol, createdAt])
}
